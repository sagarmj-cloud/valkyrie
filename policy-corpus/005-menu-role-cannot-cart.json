{"name": "menu role cannot call a write tool",
 "rule": "valkyrie/tool_authz/decision",
 "input": {"agent": {"id": "menu-01", "role": "menu"}, "principal": {"sub": "jane", "tenant_id": "acme"},
           "tool": {"name": "orders.create_cart", "risk_tier": 2, "data_classification": "confidential",
                    "args": {"customer_id": "c-42", "items": ["Margherita Pizza"]}},
           "customer": {"id": "c-42", "diet": "vegetarian", "allergens": [], "budget_usd": 25}},
 "expect": {"allow": false, "deny_reason_contains": ["tool_not_bound_to_role", "risk_tier_exceeds_role"]}}
